# Copie para .env:  cp .env.example .env
# Em produção: ENVIRONMENT=production, SEED_DEMO=false, SECRET_KEY e senha do banco fortes.

POSTGRES_USER=furconhub
POSTGRES_PASSWORD=furconhub_dev
POSTGRES_DB=furconhub
DB_PORT=5432

# gere com:  openssl rand -hex 32
SECRET_KEY=dev-insecure-change-me-dev-insecure-change-me
ENVIRONMENT=development

# true = cria dados e contas de DEMONSTRAÇÃO (senha Demo@12345) e mostra atalhos no login
SEED_DEMO=true

WEB_PORT=8080

# taxa do provedor de pagamento aplicada a cada ingresso pago (cálculo no backend)
PAYMENT_FEE_PERCENT=3.99
PAYMENT_FEE_FIXED_CENTS=39

# apenas para o túnel nomeado da Cloudflare (profile named-tunnel)
TUNNEL_TOKEN=

# Mapa: o provedor padrão (tile.openstreetmap.org) é só para desenvolvimento/baixo volume.
# Em produção use um provedor contratado, ex.: https://api.maptiler.com/maps/streets/{z}/{x}/{y}.png?key=SUA_CHAVE
VITE_TILE_URL=
VITE_TILE_ATTRIBUTION=

# Geocodificação (busca de endereço do organizador). Nominatim público: 1 req/s, identifique-se com um contato real.
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=FurConHub/0.1 (contato@seudominio.com)
